{
  "name": "wechat-agent-bridge-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "check:api": "node scripts/check-contracts.mjs",
    "format": "prettier --write src tests e2e scripts *.ts *.json",
    "format:check": "prettier --check src tests e2e scripts *.ts *.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ai": "playwright test --config playwright.integration.config.ts",
    "test:e2e:https": "node scripts/check-https.mjs"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.0",
    "vue": "3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "^3.0.0"
  }
}
